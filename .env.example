APP_NAME="ComplyBuild CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=complybuild_crm
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_PREFIX=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@complybuild.com"
MAIL_FROM_NAME="${APP_NAME}"

# Lead Automation Configuration
LEAD_AUTOMATION_ENABLED=true
LEAD_AUTOMATION_MAX_EXECUTIONS_PER_HOUR=100
LEAD_AUTOMATION_LOOP_THRESHOLD=5

SCOUT_DRIVER=null

VITE_APP_NAME="${APP_NAME}"
